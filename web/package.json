{
  "name": "@gin-enterprise/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --ignore-path=.oxfmtignore src scripts e2e package.json tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts --write",
    "format:check": "oxfmt --check --ignore-path=.oxfmtignore src scripts e2e package.json tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "api:check": "node scripts/check-api-contract.mjs",
    "dependencies:check": "node scripts/check-dependency-policy.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "browser-bundle:check": "node scripts/check-browser-bundle.mjs",
    "production:smoke": "node scripts/check-production-smoke.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm dependencies:check && pnpm boundaries:check && pnpm typecheck && pnpm api:check && pnpm test",
    "check:release": "pnpm check && pnpm test:coverage && pnpm build && pnpm browser-bundle:check && pnpm production:smoke && pnpm test:e2e",
    "prepare": "if [ -d ../.git ]; then cd .. && ./web/node_modules/.bin/husky web/.husky; fi"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@hookform/resolvers": "5.9.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-table": "9.2.3",
    "lucide-react": "1.34.0",
    "motion": "13.1.1",
    "nuqs": "2.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tanstack/nitro-v2-vite-plugin": "1.155.0",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.4.1",
    "msw": "2.15.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,md}": [
      "oxfmt --write"
    ],
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint"
    ]
  },
  "engines": {
    "node": ">=26.8.1",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0"
}
