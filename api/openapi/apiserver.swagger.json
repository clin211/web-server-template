        },
        "message": {
          "type": "string",
          "title": "message 表示提示信息"
        },
        "data": {
          "$ref": "#/definitions/v1DeleteUserResponse",
          "title": "data 表示业务数据"
        }
      },
      "title": "DeleteUserResponseEnvelope 表示删除用户的成功响应包络"
    },
    "v1GetUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
