        },
        "message": {
          "type": "string",
          "title": "message 表示提示信息"
        },
        "data": {
          "$ref": "#/definitions/v1GetUserResponse",
          "title": "data 表示业务数据"
        }
      },
      "title": "GetUserResponseEnvelope 表示获取用户的成功响应包络"
    },
    "v1HealthzResponse": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/v1ServiceStatus",
          "title": "status 表示服务的健康状态。"
        },
        "timestamp": {
          "type": "string",
          "title": "timestamp 表示请求的时间戳。"
        },
        "message": {
          "type": "string",
          "title": "message 表示可选的状态消息，用于提供关于服务健康状态的额外\n信息。"
        },
        "version": {
          "type": "string",
          "title": "version 表示服务版本。"
        }
      },
      "title": "HealthzResponse 表示健康检查的响应结构。"
    },
    "v1HealthzResponseEnvelope": {
      "type": "object",
