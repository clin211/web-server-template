        },
        "nickname": {
          "type": "string",
          "title": "nickname 表示用户昵称"
        },
        "email": {
          "type": "string",
          "title": "email 表示用户电子邮箱"
        },
        "phone": {
          "type": "string",
          "title": "phone 表示用户手机号"
        }
      },
      "title": "CreateUserRequest 表示创建用户请求"
    },
    "v1CreateUserResponse": {
      "type": "object",
      "properties": {
        "userID": {
          "type": "string",
          "title": "userID 表示新创建的用户 ID"
        }
      },
      "title": "CreateUserResponse 表示创建用户响应"
    },
    "v1CreateUserResponseEnvelope": {
      "type": "object",
