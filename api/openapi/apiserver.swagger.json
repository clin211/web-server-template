        "data": {
          "$ref": "#/definitions/v1CreateUserResponse",
          "title": "data 表示业务数据"
        }
      },
      "title": "CreateUserResponseEnvelope 表示创建用户的成功响应包络"
    },
    "v1DeleteUserResponse": {
