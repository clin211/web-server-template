        }
      },
      "title": "LogoutResponseEnvelope 表示退出登录的成功响应包络"
    },
    "v1ServiceStatus": {
      "type": "string",
      "enum": [
        "Healthy",
        "Unhealthy"
      ],
      "default": "Healthy",
      "description": "- Healthy: Healthy 表示服务处于健康状态。\n - Unhealthy: Unhealthy 表示服务处于不健康状态。",
      "title": "ServiceStatus 表示服务的健康状态。"
    },
