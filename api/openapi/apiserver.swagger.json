{
  "swagger": "2.0",
  "info": {
    "title": "API Server v1",
    "description": "基于 gin-enterprise-template 的通用后端 API 服务：\n- JWT 用户认证\n- 用户基础管理\n- RESTful 资源接口\n- OpenTelemetry 可观测性",
    "version": "1.0",
    "contact": {
      "name": "gin-enterprise-template 项目",
      "url": "https://github.com/clin211/gin-enterprise-template",
      "email": "767425412lin@gmail.com"
    }
  },
  "tags": [
    {
      "name": "APIServer"
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "健康检查",
        "description": "检查服务是否健康运行",
        "operationId": "APIServer_Healthz",
        "responses": {
          "200": {
            "description": "服务健康状态",
            "schema": {
              "$ref": "#/definitions/v1HealthzResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "tags": [
          "服务治理"
        ]
      }
    },
    "/v1/auth/info": {
      "get": {
        "summary": "获取当前用户信息",
        "description": "使用当前访问令牌获取当前用户的脱敏资料",
        "operationId": "APIServer_Info",
        "responses": {
          "200": {
            "description": "当前登录用户的脱敏资料",
            "schema": {
              "$ref": "#/definitions/v1InfoResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "tags": [
          "用户认证"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "用户登录",
        "description": "用户使用用户名和密码进行登录认证",
        "operationId": "APIServer_Login",
        "responses": {
          "200": {
            "description": "登录成功，返回访问令牌与刷新令牌",
            "schema": {
              "$ref": "#/definitions/v1LoginResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LoginRequest"
            }
          }
        ],
        "tags": [
          "用户认证"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "退出登录",
        "description": "撤销当前用户已签发的访问令牌和刷新令牌",
        "operationId": "APIServer_Logout",
        "responses": {
          "200": {
            "description": "退出成功",
            "schema": {
              "$ref": "#/definitions/v1LogoutResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "tags": [
          "用户认证"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/auth/refresh-token": {
      "put": {
        "summary": "刷新令牌",
        "description": "使用现有令牌刷新获取新的访问令牌",
        "operationId": "APIServer_RefreshToken",
        "responses": {
          "200": {
            "description": "刷新成功，返回新的访问令牌与刷新令牌",
            "schema": {
              "$ref": "#/definitions/v1LoginResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "tags": [
          "用户认证"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/users": {
      "get": {
        "summary": "列表用户",
        "description": "获取所有用户的列表",
        "operationId": "APIServer_ListUsers",
        "responses": {
          "200": {
            "description": "用户列表与分页游标",
            "schema": {
              "$ref": "#/definitions/v1ListUserResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "parameters": [
          {
            "name": "pageToken",
            "description": "page_token 表示分页游标，用于获取下一页数据\n首次请求时为空，后续请求使用上一页返回的 page_token\n@gotags: form:\"page_token\"",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "pageSize",
            "description": "page_size 表示每页数量\n@gotags: form:\"page_size\"",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "用户管理"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "创建用户",
        "description": "创建一个新的用户",
        "operationId": "APIServer_CreateUser",
        "responses": {
          "200": {
            "description": "创建成功，返回新用户 ID",
            "schema": {
              "$ref": "#/definitions/v1CreateUserResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateUserRequest"
            }
          }
        ],
        "tags": [
          "用户管理"
        ]
      }
    },
    "/v1/users/{userID}": {
      "get": {
        "summary": "获取用户",
        "description": "根据用户 ID 获取用户信息",
        "operationId": "APIServer_GetUser",
        "responses": {
          "200": {
            "description": "用户信息",
            "schema": {
              "$ref": "#/definitions/v1GetUserResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "parameters": [
          {
            "name": "userID",
            "description": "userID 表示用户 ID\n@gotags: uri:\"userID\"",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "用户管理"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "delete": {
        "summary": "删除用户",
        "description": "根据用户 ID 删除用户",
        "operationId": "APIServer_DeleteUser",
        "responses": {
          "200": {
            "description": "删除成功",
            "schema": {
              "$ref": "#/definitions/v1DeleteUserResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "parameters": [
          {
            "name": "userID",
            "description": "userID 表示用户 ID\n@gotags: uri:\"userID\"",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "用户管理"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "put": {
        "summary": "更新用户",
        "description": "根据用户 ID 更新用户信息",
        "operationId": "APIServer_UpdateUser",
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": {
              "$ref": "#/definitions/v1UpdateUserResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "parameters": [
          {
            "name": "userID",
            "description": "userID 表示用户 ID\n@gotags: uri:\"userID\"",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/APIServerUpdateUserBody"
            }
          }
        ],
        "tags": [
          "用户管理"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/users/{userID}/change-password": {
      "put": {
        "summary": "修改密码",
        "description": "当前用户修改自己的密码",
        "operationId": "APIServer_ChangePassword",
        "responses": {
          "200": {
            "description": "修改成功",
            "schema": {
              "$ref": "#/definitions/v1ChangePasswordResponseEnvelope"
            }
          },
          "default": {
            "description": "统一错误响应",
            "schema": {
              "$ref": "#/definitions/v1APIError"
            }
          }
        },
        "parameters": [
          {
            "name": "userID",
            "description": "userID 表示用户 ID\n@gotags: uri:\"userID\"",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/APIServerChangePasswordBody"
            }
          }
        ],
        "tags": [
          "用户管理"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "APIServerChangePasswordBody": {
      "type": "object",
      "properties": {
        "oldPassword": {
          "type": "string",
          "title": "oldPassword 表示当前密码"
        },
        "newPassword": {
          "type": "string",
          "title": "newPassword 表示准备修改的新密码"
        }
      },
      "title": "ChangePasswordRequest 表示修改密码请求"
    },
    "APIServerUpdateUserBody": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "title": "username 表示可选的用户名称"
        },
        "nickname": {
          "type": "string",
          "title": "nickname 表示可选的用户昵称"
        },
        "email": {
          "type": "string",
          "title": "email 表示可选的用户电子邮箱"
        },
        "phone": {
          "type": "string",
          "title": "phone 表示可选的用户手机号"
        }
      },
      "title": "UpdateUserRequest 表示更新用户请求"
    },
    "v1APIError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32",
          "title": "code 表示业务错误码，如 50101 表示认证失败"
        },
        "message": {
          "type": "string",
          "title": "message 表示用户可读的错误信息"
        },
        "reason": {
          "type": "string",
          "title": "reason 表示错误原因标识，用于程序化判断"
        }
      },
      "title": "APIError 表示统一错误响应包络，所有非 2xx 响应共用（default 响应）。"
    },
    "v1ChangePasswordResponse": {
      "type": "object",
      "title": "ChangePasswordResponse 表示修改密码响应"
    },
    "v1ChangePasswordResponseEnvelope": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32",
          "title": "code 表示业务状态码，0 表示成功"
        },
        "message": {
          "type": "string",
          "title": "message 表示提示信息"
        },
        "data": {
          "$ref": "#/definitions/v1ChangePasswordResponse",
          "title": "data 表示业务数据"
        }
      },
      "title": "ChangePasswordResponseEnvelope 表示修改密码的成功响应包络"
    },
    "v1CreateUserRequest": {
      "type": "object",
      "properties": {
