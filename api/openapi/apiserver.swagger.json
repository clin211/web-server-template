        },
        "message": {
          "type": "string",
          "title": "message 表示提示信息"
        },
        "data": {
          "$ref": "#/definitions/v1HealthzResponse",
          "title": "data 表示业务数据"
        }
      },
      "title": "HealthzResponseEnvelope 表示健康检查的成功响应包络"
    },
    "v1InfoResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
          "title": "user 表示当前登录用户信息，不包含密码等敏感字段"
        }
      },
      "title": "InfoResponse 表示当前用户信息响应。"
    },
    "v1InfoResponseEnvelope": {
      "type": "object",
